{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "opener:default",
    "store:default",
    "dialog:default",
    "core:default",
    "core:window:allow-destroy",
    "core:menu:default",
    "os:allow-locale"
  ]
}
